<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
	xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
	<modelVersion>4.0.0</modelVersion>
	<parent>
		<groupId>org.springframework.boot</groupId>
		<artifactId>spring-boot-starter-parent</artifactId>
		<version>3.5.3</version>
		<relativePath/> <!-- lookup parent from repository -->
	</parent>
	<groupId>com.learnpr1</groupId>
	<artifactId>journalApp</artifactId>
	<version>0.0.1-SNAPSHOT</version>
	<name>JournalApp</name>
	<description>End2EndJA</description>
	<url/>
	<licenses>
		<license/>
	</licenses>
	<developers>
		<developer/>
	</developers>
	<scm>
		<connection/>
		<developerConnection/>
		<tag/>
		<url/>
	</scm>
	<properties>
		<java.version>24</java.version>
	</properties>
	<dependencies>
		<dependency>
			<groupId>org.springframework.boot</groupId>
			<artifactId>spring-boot-starter-web</artifactId>
		</dependency>

		<dependency>
			<groupId>org.springframework.boot</groupId>
			<artifactId>spring-boot-starter-test</artifactId>
			<scope>test</scope>
		</dependency>

		<dependency>
			<groupId>org.springframework.boot</groupId>
			<artifactId>spring-boot-starter-data-mongodb</artifactId>
			<version>3.5.0</version>
		</dependency>
		<dependency>
			<groupId>org.projectlombok</groupId>
			<artifactId>lombok</artifactId>
			<version>1.18.38</version>
			<scope>provided</scope>
		</dependency>

		<dependency>
			<groupId>org.springframework.boot</groupId>
			<artifactId>spring-boot-starter-security</artifactId>
			<version>3.5.0</version>
		</dependency>

		<dependency>
			<groupId>com.mashape.unirest</groupId>
			<artifactId>unirest-java</artifactId>
			<version>1.4.9</version>
		</dependency>

		<dependency>
			<groupId>io.jsonwebtoken</groupId>
			<artifactId>jjwt-api</artifactId>
			<version>0.12.6</version>
		</dependency>

<!--		jackson is the default JSON library for Spring Boot 3.x, but if you want to use JJWT with Jackson, you need to include the following dependencies:-->

		<dependency>
			<groupId>io.jsonwebtoken</groupId>
			<artifactId>jjwt-jackson</artifactId>
			<version>0.12.6</version>
			<scope>runtime</scope>
		</dependency>

		<!--we want its implementation to be runtime only-->

		<dependency>
			<groupId>io.jsonwebtoken</groupId>
			<artifactId>jjwt-impl</artifactId>
			<version>0.12.6</version>
			<scope>runtime</scope>
		</dependency>

        <dependency>
            <groupId>org.mockito</groupId>
            <artifactId>mockito-inline</artifactId>
            <version>5.2.0</version>
            <scope>test</scope>
        </dependency>
<!--        The Mockito warning is about Java 22+ blocking dynamic agents.-->
<!--        // Mockito-inline is used for mocking final classes and methods in tests-->
<!--        this suppresses the warning that we get while using mockito with java 17 and above-->
<!--        Right now, I’m dynamically attaching myself as an agent at runtime. Future Java versions won’t allow this, so you should explicitly configure me as an agent in your build instead.”-->
<!--        ✅ Why this happens-->
<!--        Newer JDKs (22+) restrict dynamic agent loading for security/stability reasons.-->
<!--        Mockito (when using inline mocking) uses ByteBuddy Agent to mock final classes, static methods, etc.-->
<!--        Since Java is tightening rules, Mockito warns you to configure it properly.-->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-mail</artifactId>
            <version>4.0.0-M2</version>
        </dependency>
<!--        spring boot starter mail is used to send emails in spring boot applications-->

<!--        <dependency>-->
<!--            <groupId>org.springframework.boot</groupId>-->
<!--            <artifactId>spring-boot-starter-data-redis</artifactId>-->
<!--            <version>4.0.0-M2</version>-->
<!--        </dependency>-->
<!--        //spring boot starter data redis is used to interact with redis database in spring boot applications-->

        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-data-redis</artifactId>
        </dependency>

        <dependency>
            <groupId>com.fasterxml.jackson.datatype</groupId>
            <artifactId>jackson-datatype-jsr310</artifactId>
        </dependency>


        <dependency>
            <groupId>com.google.genai</groupId>
            <artifactId>google-genai</artifactId>
            <version>1.15.0</version>
        </dependency>




    </dependencies>

    <build>
        <plugins>
            <plugin>
                <groupId>org.springframework.boot</groupId>
                <artifactId>spring-boot-maven-plugin</artifactId>

            </plugin>
            <plugin>
                    <groupId>org.apache.maven.plugins</groupId>
                    <artifactId>maven-surefire-plugin</artifactId>
                    <version>3.5.3</version>
                    <configuration>
                        <argLine>-XX:+EnableDynamicAgentLoading</argLine>
<!--                        the above line enables dynamic agent loading by adding the JVM argument -XX:+EnableDynamicAgentLoading.-->
<!--                        This is necessary for Mockito to function properly with Java 22 and above.-->
                        <argLine>
                            -javaagent:${settings.localRepository}/net/bytebuddy/byte-buddy-agent/1.17.6/byte-buddy-agent-1.17.6.jar
<!--                            the above line specifies the path to the ByteBuddy agent JAR file, which is required for Mockito to perform inline mocking.-->

                        </argLine>
                    </configuration>
            </plugin>
<!--            I have added the above maven-surefire-plugin to supress the warning-->
<!--            It does EnableDynamicAgentLoading-->
<!--            surefire-plugins purpose is to run the unit tests of an application.-->
<!--            It is used during the test phase of the build lifecycle.-->
<!--            It generates reports in different formats, including plain text, XML, and HTML.-->
<!--            It can be configured to include or exclude specific tests based on patterns.-->
<!--            It supports parallel test execution to speed up the testing process.-->
        </plugins>
    </build>

</project>
